# Copy to .env and adjust as needed (docker compose reads it automatically).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ailit

# Host port the questionnaire is served on (http://localhost:WEB_PORT).
WEB_PORT=8080

# The result screen explains how each answer produced the profile. Set to false
# to show only right/wrong and keep the answer key hidden from participants.
REVEAL_ANSWERS=true
