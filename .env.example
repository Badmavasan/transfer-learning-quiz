# Copy to .env and adjust as needed (docker compose reads it automatically).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ailit

# Host port the questionnaire is served on (http://localhost:WEB_PORT).
WEB_PORT=8080

# The result screen explains how each answer produced the profile. Set to false
# to show only right/wrong and keep the answer key hidden from participants.
REVEAL_ANSWERS=true

# --- Teacher area -------------------------------------------------------
# Signs the anti-robot challenge. Set a long random value in production,
# otherwise a new one is generated at every boot (pending captchas expire).
CAPTCHA_SECRET=

# Send the session cookie only over HTTPS. Turn this on once you serve the
# platform over TLS; leave it off for plain-http local runs.
COOKIE_SECURE=false

# Max teacher sign-ups per hour from one IP address (schools share one).
SIGNUP_PER_HOUR=20

# Class results stay hidden until this many students have finished, so a class
# average can never single out one identifiable student.
MIN_CLASS_REPORTING=3

# --- Email (address confirmation + password reset) ----------------------
# Leave SMTP_HOST empty to disable sending: links are printed to the server
# log instead, which is handy in development.
SMTP_HOST=smtp.example.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.org
SMTP_PASSWORD=
MAIL_FROM="Your Name <noreply@example.org>"

# Absolute base URL used to build the links inside those emails. Must be the
# address teachers actually reach the platform on.
PUBLIC_URL=https://your-host
